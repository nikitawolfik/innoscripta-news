# Copy to `.env` and fill in. These are read ONLY by the server-side proxy
# (src/server/), never by client code, so they are not prefixed with VITE_ and
# never reach the browser bundle.

# https://newsapi.org/register
NEWSAPI_KEY=

# https://open-platform.theguardian.com/access/
GUARDIAN_KEY=

# https://developer.nytimes.com/get-started
NYT_KEY=
